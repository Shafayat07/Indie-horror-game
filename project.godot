; Engine configuration file.
config_version=5

[application]

config/name="The Tide Remembers"
config/description="A first-person psychological horror game about an island that hears the future."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.01, 0.012, 0.015, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="interact"
3d_physics/layer_5="trigger"

[physics]

common/physics_ticks_per_second=60

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.03, 1)
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48

[navigation]

3d/default_cell_size=0.3
3d/default_cell_height=0.25
3d/merge_rasterizer_cell_scale=0.001

[debug]

gdscript/warnings/inference_on_variant=1
